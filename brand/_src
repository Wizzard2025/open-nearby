def cards(rows):
    return '<div class="cards">' + "".join(
        f'<div class="card {st}"><div class="ic"><svg viewBox="0 0 24 24">{ICONS[i]}</svg></div>'
        f'<div class="nm"><b>{n}</b><span>{d}</span></div><div class="st">{lab}</div></div>'
        for i, n, d, st, lab in rows) + "</div>"


def page(lang, w, h, u, lh, body):
    c = COPY[lang]
    return (f'<!doctype html><html lang="{lang}"><head><meta charset="utf-8"><style>'
            f':root{{--w:{w}px;--h:{h}px;--u:{u}px;--lh:{lh}px}}{CSS}</style></head>'
            f'<body><div class="grid"></div><div dir="{c["dir"]}" style="position:relative;height:100%">{body}</div></body></html>')


